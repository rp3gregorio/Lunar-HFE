# Byte-compiled
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
wheels/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Type checkers / linters
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# IDEs / OS
.vscode/
.idea/
*.swp
.DS_Store

# Diviner GCP tile data — fetched on demand by scripts/fetch_diviner.py
code/data/diviner/gcp/*.tab

# LaTeX build artifacts — path-agnostic so they stay ignored no matter
# where the documents live (they moved to deliverables/documents/ in the
# 2026-07-06 reorg; the old paper/** and docs/** rules had gone dead).
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.log
*.out
*.lof
*.lot
*.toc
*.nav
*.snm
*.vrb
*.synctex.gz

# Reference papers (copyrighted, local use only)
code/references/*.pdf
code/references/**/*.pdf

# Working scratch
.scratch/
*.tmp

# Large Diviner GCP raw tables (>100MB, exceed GitHub limit; downloadable input)
code/data/diviner/gcp/*_002.tab
# scratch
tmp/

# C++ benchmark scratch I/O (regenerated by benchmark_cpp.py)
code/results/.cpp_io/

# Overleaf submission package — regenerated on demand from documents/jgr/letter/
/letter_overleaf/
/letter_overleaf.zip

# Stray AOGS-data duplicate left by an incomplete move; the AOGS subtree was
# removed in the reorg and its large LOLA/SLDEM data does not belong in git
/deliverables/

# Large LOLA DEM (downloadable PDS input; used by context-map / AOGS figures)
code/data/lola/
