# Byte-compiled
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
wheels/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Type checkers / linters
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# IDEs / OS
.vscode/
.idea/
*.swp
.DS_Store

# Node (the GEDES defense deck builds with pptxgenjs; restore with `npm ci`)
node_modules/

# MS Office lock files left behind by an open .pptx/.docx/.xlsx
~$*

# Diviner GCP tile data — fetched on demand by scripts/fetch_diviner.py
code/data/diviner/gcp/*.tab

# LaTeX build artifacts — path-agnostic so they stay ignored no matter
# where the documents live (they moved to deliverables/documents/ in the
# 2026-07-06 reorg; the old paper/** and docs/** rules had gone dead).
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.log
*.out
*.lof
*.lot
*.toc
*.nav
*.snm
*.vrb
*.synctex.gz

# Manuscripts live OUTSIDE this repository, in the document set at $LUNAR_DOCS
# (default ~/Documents/Lunar-HFE/). documents/ here keeps only the reproduction
# notes and the developer tour. These rules are a guard: if a manuscript folder
# is ever copied back in by accident, it stays out of git.
/documents/jgr/
/documents/gedes/
/documents/aogs/
/documents/slides/

# Reference papers (copyrighted, local use only)
code/references/*.pdf
code/references/**/*.pdf

# Working scratch
.scratch/
*.tmp

# Large Diviner GCP raw tables (>100MB, exceed GitHub limit; downloadable input)
code/data/diviner/gcp/*_002.tab
# scratch
tmp/

# C++ benchmark scratch I/O (regenerated by benchmark_cpp.py)
code/results/.cpp_io/

# Overleaf submission package — regenerated on demand from documents/jgr/letter/.
# Both the old and current export names, so neither can drift back into git.
/letter_overleaf/
/letter_overleaf.zip
/Lunar-HFE_article_overleaf/
/Lunar-HFE_article_overleaf.zip

# Stray AOGS-data duplicate left by an incomplete move; the AOGS subtree was
# removed in the reorg and its large LOLA/SLDEM data does not belong in git
/deliverables/

# Large LOLA DEM (downloadable PDS input; used by context-map / AOGS figures)
code/data/lola/

# Generated symlink view (rebuild: code/pipeline/figures/build_figure_views.py)
figures/_by_document/

# --- Generated outputs -------------------------------------------------
# Figures are BUILD PRODUCTS, not sources: run `make figures` (or the
# individual pipeline/figures/make_*.py) to regenerate every one of them.
# Keeping them out of the repo keeps it to code + data.
figures/*
!figures/.gitkeep

# Rendered documents. The .md/.tex sources are tracked; the PDFs are not.
*.pdf

# Third-party paper PDFs are NOT redistributed here (they are copyrighted
# by their publishers). code/references/README.md and WANTED.md list what
# to fetch and from where.
code/references/*.pdf
